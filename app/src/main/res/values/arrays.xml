<?xml version="1.0" encoding="utf-8"?>
<resources>

    <declare-styleable name="YouTubePlayerView">
        <attr name="enableAutomaticInitialization" format="boolean" />
        <attr name="videoId" format="string" />
        <attr name="autoPlay" format="boolean" />
        <attr name="handleNetworkEvents" format="boolean" />
    </declare-styleable>

    <string-array name="resolution_names">
        <item>@string/resolution_720p</item>
        <item>@string/resolution_1080p</item>
        <item>@string/resolution_1440p</item>
        <item>@string/resolution_4k</item>
    </string-array>

    <!-- Keep this in sync with PreferenceConfiguration.isNativeResolution()! -->
    <string-array name="resolution_values" translatable="false">
        <item>1280x720</item>
        <item>1920x1080</item>
        <item>2560x1440</item>
        <item>3840x2160</item>
    </string-array>

    <string-array name="fps_names">
        <item>@string/fps_30</item>
        <item>@string/fps_60</item>
        <item>@string/fps_90</item>
        <item>@string/fps_120</item>
    </string-array>
    <string-array name="fps_values" translatable="false">
        <item>30</item>
        <item>60</item>
        <item>90</item>
        <item>120</item>
    </string-array>

    <string-array name="audio_config_names">
        <item>@string/audioconf_stereo</item>
        <item>@string/audioconf_51surround</item>
        <item>@string/audioconf_71surround</item>
    </string-array>
    <string-array name="audio_config_values" translatable="false">
        <item>2</item>
        <item>51</item>
        <item>71</item>
    </string-array>

    <string-array name="audio_output_mode_names">
        <item>@string/audio_output_mode_pcm</item>
        <item>@string/audio_output_mode_ac3_auto</item>
        <item>@string/audio_output_mode_ac3_force</item>
        <item>@string/audio_output_mode_eac3_auto</item>
        <item>@string/audio_output_mode_eac3_force</item>
    </string-array>
    <string-array name="audio_output_mode_values" translatable="false">
        <item>pcm</item>
        <item>ac3_auto</item>
        <item>ac3_force</item>
        <item>eac3_auto</item>
        <item>eac3_force</item>
    </string-array>

    <!-- Don't forget to update locales_config.xml when you modify this! -->
    <string-array name="language_names" translatable="false">
        <item>Default</item>
        <item>English</item>
        <item>Italiano</item>
        <item>Polski</item>
        <item>Bŭlgarski</item>
        <item>日本語</item>
