        <item>Français</item>
        <item>Deutsch</item>
        <item>Română</item>
        <item>Українська</item>
        <item>Norsk</item>
        <item>Tiếng Việt</item>
        <item>Magyar</item>
        <item>Ελληνικά</item>
        <item>Português</item>
        <item>Čeština</item>
        <item>Svenska</item>
        <item>Indonesia</item>
        <item>Türkçe</item>
    </string-array>
    <string-array name="language_values" translatable="false">
        <item>default</item>
        <item>en</item>
        <item>it</item>
        <item>pl</item>
        <item>bg</item>
