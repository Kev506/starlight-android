<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--Gamer Theme used only for the activities context menu-->

    <!--Checkbox-->
    <style name="checkbox" parent="android:Widget.Material.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/checkbox_checked</item>
    </style>

    <!--Dialog Menu's-->
    <style name="DialogTheme" parent="Theme.MaterialComponents.Dialog">
        <item name="android:buttonBarButtonStyle">@style/DialogButtonStyle</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/list_item</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:colorControlNormal">@color/checkbox_checked_light</item>
        <item name="android:windowBackground">@drawable/dialog_gamer</item>
        <item name="android:colorAccent">@android:color/holo_blue_light</item>
    </style>

    <style name="AppTheme.AlertDialogTheme" parent="Theme.MaterialComponents.Dialog.Alert">
        <item name="dialogCornerRadius">20dp</item>
        <item name="buttonBarButtonStyle">@style/DialogButtonStyle</item>
        <item name="android:listChoiceBackgroundIndicator">@drawable/list_item</item>
        <item name="colorPrimary">@android:color/white</item>
        <item name="android:windowBackground">@drawable/dialog_gamer</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:textColorAlertDialogListItem">@android:color/white</item>
    </style>
    <!--Dialog Button-->
    <style name="DialogButtonStyle">
        <item name="android:background">@drawable/dialog_button_dark</item>
        <item name="android:layout_marginLeft">@dimen/button_margin</item>
        <item name="android:layout_marginRight">@dimen/button_margin</item>
    </style>

    <!--Popup Menu-->
    <style name="AppTheme.DropDownList" parent="Widget.Material3.PopupMenu.ContextMenu">
        <item name="android:listChoiceBackgroundIndicator">@drawable/list_item</item>
        <item name="android:textColor">@android:color/white</item>
        <item name="android:colorControlNormal">@color/checkbox_checked_light</item>
        <item name="android:popupBackground">@drawable/dialog_gamer</item>
        <item name="android:colorAccent">#FF026D91</item>
        <item name="android:listPreferredItemPaddingStart">16dp</item>
        <item name="android:listPreferredItemPaddingEnd">16dp</item>
    </style>

    <!-- Gamer Theme-->
    <style name="GamerTheme" parent="Theme.MaterialComponents.NoActionBar">
        <!--Popup Menu-->
        <item name="android:contextPopupMenuStyle">@style/AppTheme.DropDownList</item>
        <!-- Alert Dialog-->
        <item name="alertDialogTheme">@style/AppTheme.AlertDialogTheme</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
        <!--Checkbox Style-->
        <item name="android:checkboxStyle">@style/checkbox</item>
    </style>

</resources>