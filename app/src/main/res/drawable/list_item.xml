<?xml version="1.0" encoding="utf-8"?>
<inset xmlns:android="http://schemas.android.com/apk/res/android"
    android:insetLeft="8dp"
    android:insetRight="8dp"
    android:insetTop="2dp"
    android:insetBottom="2dp">
<selector>
    <item android:state_pressed="true">
        <shape android:bottom="@dimen/padding_6" android:left="@dimen/padding_6" android:right="@dimen/padding_6" android:top="@dimen/padding_6" android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle" android:bottom="@dimen/padding_6" android:left="@dimen/padding_6" android:right="@dimen/padding_6" android:top="@dimen/padding_6">
            <solid android:color="#1F151618" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle" android:bottom="@dimen/padding_6" android:left="@dimen/padding_6" android:right="@dimen/padding_6" android:top="@dimen/padding_6">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="@dimen/radius" />
        </shape>
    </item>
</selector>
</inset>